#header
  margin: 0 auto 2rem
  width: 100%

  h1, .h1
    margin-top: 0
    margin-bottom: 0
    color: $color-text
    letter-spacing: .01em
    font-weight: 700
    font-style: normal
    font-size: 1.5rem
    line-height: 2rem

    antialias()

  a
    background: none
    color: inherit
    text-decoration: none

  #logo
    display: inline-block
    float: left
    margin-right: 20px
    width: $logo-width
    height: $logo-height
    border-radius: 5px
    background-size: $logo-width $logo-height
    background-repeat: no-repeat
    if $logo-grayout
      filter: grayscale(100%)
      -webkit-filter: grayscale(100%)

  #nav
    color: $color-accent-1
    letter-spacing: .01em
    font-weight: 200
    font-style: normal
    font-size: .8rem

    ul
      display: flex
      flex-wrap: wrap
      align-items: center
      gap: .55rem 0
      margin: 0
      padding: 0
      list-style-type: none
      line-height: 15px

      a
        margin-right: 15px
        color: $color-accent-1
        white-space: nowrap

      a:hover
        underline(5px, $color-accent-1)

      .language-switcher
        position: relative

        button
          margin: 0
          padding: 0
          border: 0
          background: none
          color: $color-accent-1
          font: inherit
          cursor: pointer

        .language-switcher-toggle
          margin-right: 15px

          span:first-child
            margin-right: 6px
            color: $color-text

          .language-switcher-current
            margin-right: 5px

        .language-switcher-menu
          position: absolute
          top: 1.5rem
          right: 15px
          z-index: 20
          display: none
          min-width: 7rem
          padding: .35rem 0
          border: 1px dotted $color-accent-1
          background: $color-background
          line-height: 1.8

          li
            display: block
            margin: 0
            border-right: 0

          button
            display: block
            width: 100%
            padding: .2rem .75rem
            text-align: left
            white-space: nowrap

          button:hover,
          button.active
            color: $color-text

          button.active
            font-weight: 700

        &.open
          .language-switcher-menu
            display: block

      li
        display: block
        margin-right: 15px
        border-right: 1px dotted
        border-color: $color-accent-1
        vertical-align: middle
        white-space: nowrap

      .icon
        display: none

      li:last-child
        margin-right: 0
        border-right: 0

        a
          margin-right: 0

      li.language-switcher
        flex: 0 0 auto
        margin-left: auto
        margin-right: 0
        border-right: 0
        white-space: nowrap

        .language-switcher-toggle
          margin-right: 0

        .language-switcher-menu
          right: 0

          button
            margin-right: 0

if $logo-grayout
  #header:hover
    #logo
      filter: none
      -webkit-filter: none

@media screen and (max-width: 480px)
  #header #title
    display: table
    margin-right: 5rem
    min-height: $logo-height
    h1
      display: table-cell
      vertical-align: middle

  #header #nav
    ul
      display: block

      a:hover
        background: none

      li
        display: none
        border-right: 0

      li.icon
        position: absolute
        top: 77px
        right: 1rem
        display: inline-block
        text-align: center

    ul.responsive
      li
        display: block
    
    ul 
      a[aria-label="Menu"]
        display: inline-block
        min-width: 48px
        min-height: 48px

    li:not(:first-child)
      padding-top: 1rem
      padding-left: $logo-width + 20px
      font-size: 1rem

    .language-switcher
      float: none
      margin-left: 0
      margin-top: 1rem
      padding-bottom: .25rem
      border-top: 1px dotted $color-accent-1
      white-space: normal

      .language-switcher-toggle
        display: inline-flex
        align-items: center
        gap: .3rem
        margin-right: 0

      .language-switcher-menu
        position: static
        margin-top: .5rem
        max-width: 10rem

        li
          padding-top: 0
          padding-left: 0
