<div id="header-post">
  <a id="menu-icon" href="#" aria-label="<%- __('icons.menu') %>" data-i18n-attr="aria-label:icons.menu"><i class="fa-solid fa-bars fa-lg"></i></a>
  <a id="menu-icon-tablet" href="#" aria-label="<%- __('icons.menu') %>" data-i18n-attr="aria-label:icons.menu"><i class="fa-solid fa-bars fa-lg"></i></a>
  <a id="top-icon-tablet" href="#" aria-label="<%- __('icons.top') %>" data-i18n-attr="aria-label:icons.top" onclick="$('html, body').animate({ scrollTop: 0 }, 'fast');" style="display:none;"><i class="fa-solid fa-chevron-up fa-lg"></i></a>
  <span id="menu">
    <span id="nav">
      <ul>
        <% for (var i in theme.nav) { %><!--
       --><li><a href="<%- url_for(theme.nav[i]) %>" data-i18n="nav.<%- i %>"><%= __('nav.'+i).replace("nav.", "") %></a></li><!--
     --><% } %>
        <% if (theme.language_switcher && theme.language_switcher.enabled && theme.language_switcher.languages) { %><!--
       --><% var switcherData = language_switcher_data(); %><!--
       --><% var currentLang = switcherData.currentLanguage; %><!--
       --><% var currentLanguage = switcherData.languages[currentLang] || {}; %><!--
       --><li class="language-switcher" aria-label="<%- __('language_switcher.label') %>" data-i18n-attr="aria-label:language_switcher.label"><!--
         --><button type="button" class="language-switcher-toggle" aria-haspopup="true" aria-expanded="false"><!--
           --><span data-i18n="language_switcher.label"><%= __('language_switcher.label') %></span><!--
           --><span class="language-switcher-current" data-language-current><%= currentLanguage.label || currentLang %></span><!--
           --><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><!--
         --></button><!--
         --><ul class="language-switcher-menu"><!--
         --><% for (var lang in switcherData.languages) { %><!--
           --><% var option = switcherData.languages[lang]; %><!--
           --><li><button type="button" class="<%= currentLang === lang ? 'active' : '' %>" data-language-option="<%- lang %>" lang="<%- lang %>"><%= option.label || lang %></button></li><!--
         --><% } %><!--
         --></ul><!--
       --></li><!--
     --><% } %>
      </ul>
    </span>
    <br/>
    <span id="actions">
      <ul>
        <% if (page.prev) { %>
        <li><a class="icon" aria-label="<%- __('post.desktop.previous') %>" data-i18n-attr="aria-label:post.desktop.previous" href="<%- url_for(page.prev.path) %>"><i class="fa-solid fa-chevron-left" aria-hidden="true" onmouseover="$('#i-prev').toggle();" onmouseout="$('#i-prev').toggle();"></i></a></li>
        <% } %>
        <% if (page.next) { %>
        <li><a class="icon" aria-label="<%- __('post.desktop.next') %>" data-i18n-attr="aria-label:post.desktop.next" href="<%- url_for(page.next.path) %>"><i class="fa-solid fa-chevron-right" aria-hidden="true" onmouseover="$('#i-next').toggle();" onmouseout="$('#i-next').toggle();"></i></a></li>
        <% } %>
        <li><a class="icon" aria-label="<%- __('post.desktop.back_to_top') %>" data-i18n-attr="aria-label:post.desktop.back_to_top" href="#" onclick="$('html, body').animate({ scrollTop: 0 }, 'fast');"><i class="fa-solid fa-chevron-up" aria-hidden="true" onmouseover="$('#i-top').toggle();" onmouseout="$('#i-top').toggle();"></i></a></li>
        <li><a class="icon" aria-label="<%- __('post.desktop.share') %>" data-i18n-attr="aria-label:post.desktop.share" href="#"><i class="fa-solid fa-share-alt" aria-hidden="true" onmouseover="$('#i-share').toggle();" onmouseout="$('#i-share').toggle();" onclick="$('#share').toggle();return false;"></i></a></li>
      </ul>
      <span id="i-prev" class="info" style="display:none;" data-i18n="post.desktop.previous"><%= __('post.desktop.previous') %></span>
      <span id="i-next" class="info" style="display:none;" data-i18n="post.desktop.next"><%= __('post.desktop.next') %></span>
      <span id="i-top" class="info" style="display:none;" data-i18n="post.desktop.back_to_top"><%= __('post.desktop.back_to_top') %></span>
      <span id="i-share" class="info" style="display:none;" data-i18n="post.desktop.share"><%= __('post.desktop.share') %></span>
    </span>
    <br/>
    <div id="share" style="display: none">
      <%- partial('_partial/post/share', { icon_class_name: '' }) %>
    </div>
    <% let tocHTML = toc(page.content) %>
    <% if (tocHTML !== '') { %>
      <div id="toc">
        <%- tocHTML %>
      </div>
    <% } %>
  </span>
</div>
